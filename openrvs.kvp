App.DisplayName=Raven Shield (OpenRVS)
App.RootDir=./openrvs/
App.BaseDirectory=./openrvs/19830/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=19830\system\UCC.exe
App.ExecutableLinux=/usr/bin/wine
App.WorkingDir=19830/system
App.LinuxCommandLineArgs="./UCC.exe"
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} server -ini=RavenShield.ini -servercfg=Server.ini
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=15
App.ExitString=
App.ExitFile=app_exit.lck
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[openrvsports.json]
App.AdminPortRef=GamePort
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=16
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=15
App.RCONConnectRetrySeconds=15
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.TelnetLoginFormat=
App.UpdateSources=@IncludeJson[openrvsupdates.json]
App.PreStartStages=[{"UpdateStageName":"Apply Server.ini settings","UpdateSourcePlatform":"Linux","UpdateSource":"Executable","UpdateSourceData":"/bin/bash","UpdateSourceArgs":"\"{{$FullRootDir}}set-ini.sh\" \"{{$FullBaseDir}}system/Server.ini\" \"ServerName={{ServerName}}\" \"MOTD={{MOTD}}\" \"MaxPlayers={{MaxPlayers}}\" \"UsePassword={{UsePassword}}\" \"GamePassword={{GamePassword}}\" \"UseAdminPassword=True\" \"AdminPassword={{AdminPassword}}\" \"NbTerro={{NbTerro}}\" \"DiffLevel={{DiffLevel}}\" \"FriendlyFire={{FriendlyFire}}\" \"AIBkp={{AIBkp}}\" \"RoundTime={{RoundTime}}\" \"BetweenRoundTime={{BetweenRoundTime}}\" \"RoundsPerMatch={{RoundsPerMatch}}\" \"RotateMap={{RotateMap}}\" \"DedicatedServer=True\""},{"UpdateStageName":"Apply RavenShield.ini ports","UpdateSourcePlatform":"Linux","UpdateSource":"Executable","UpdateSourceData":"/bin/bash","UpdateSourceArgs":"\"{{$FullRootDir}}set-ini.sh\" \"{{$FullBaseDir}}system/RavenShield.ini\" \"Port={{$GamePort}}\" \"ServerBeaconPort={{$ServerBeaconPort}}\" \"BeaconPort={{$BeaconPort}}\""}]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=^.*UCC\.exe.*$
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=Immediate
